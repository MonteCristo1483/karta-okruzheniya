# Локальные секреты. Скопируйте файл в .env и заполните.
# .env в .gitignore и в репозиторий не попадает.

# Ключ API портала открытых данных Москвы (apidata.mos.ru).
# Один на аккаунт, лежит в настройках профиля на портале.
MOSRU_API_KEY=

# Пароль PostGIS для пайплайна. Нужен, только если меняете дефолт
# okrug_local_dev; при смене задайте тот же пароль в POSTGRES_PASSWORD
# для docker compose. Вместо набора PG* можно задать целиком OKRUG_DSN.
# OKRUG_PASSWORD=
